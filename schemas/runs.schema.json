{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vgpu-test-catalog:schema:runs:1.0",
  "title": "Synthetic vGPU test runs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "seed",
    "generated_at",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_id": { "$ref": "#/$defs/dataset_id" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "generated_at": { "$ref": "#/$defs/utc_timestamp" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    }
  },
  "$defs": {
    "dataset_id": {
      "type": "string",
      "pattern": "^dataset-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "testcase_id",
        "gpu_id",
        "status",
        "duration_seconds",
        "iterations",
        "executed_at"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^run-[0-9]{8}$" },
        "testcase_id": { "type": "string", "pattern": "^TC-[0-9]{3}$" },
        "gpu_id": { "type": "string", "pattern": "^GPU-[A-Z]$" },
        "status": { "enum": ["passed", "failed"] },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "executed_at": { "$ref": "#/$defs/utc_timestamp" }
      }
    }
  }
}
