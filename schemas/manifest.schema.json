{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vgpu-test-catalog:schema:manifest:1.0",
  "title": "Pinned dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "created_at",
    "generator",
    "artifacts",
    "snapshot_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_id": { "$ref": "#/$defs/dataset_id" },
    "created_at": { "$ref": "#/$defs/utc_timestamp" },
    "generator": { "$ref": "#/$defs/generator" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "const": "runs.json" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["path"],
            "properties": { "path": { "const": "capabilities.json" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "snapshot_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "dataset_id": {
      "type": "string",
      "pattern": "^dataset-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "seed"],
      "properties": {
        "name": { "const": "gen_dataset" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "enum": ["runs.json", "capabilities.json"] },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
